#VRML_SIM R2025a utf8
EXTERNPROTO "../protos/NaoV6.proto"
WorldInfo {
  title "NAO V6 | Laboratorio de expressao corporal"
  basicTimeStep 12
  FPS 30
  optimalThreadCount 4
  contactProperties [
    ContactProperties { material1 "NAO foot material" material2 "floor" coulombFriction [ 1.2 ] bounce 0 }
  ]
}
Viewpoint {
  orientation 0.1128608035 0.0316479754 -0.9931066633 2.5983897803
  position 1.61 0.98 0.724
  near 0.01
  far 30
}
Background { skyColor [ 0.035 0.065 0.10 ] }
DirectionalLight { direction -1 -1 -2 intensity 1 color 0.9 0.95 1 }
DirectionalLight { direction 1 1 -1 intensity 0.6 color 0.7 0.85 1 }
Solid {
  translation 0 0 -0.025
  name "laboratory floor"
  contactMaterial "floor"
  children [ Shape { appearance PBRAppearance { baseColor 0.17 0.22 0.28 roughness 0.85 metalness 0 } geometry Box { size 4 4 0.05 } } ]
  boundingObject Box { size 4 4 0.05 }
}
DEF NAO NaoV6 {
  translation 0 0 0.334
  rotation 0 0 1 0
  name "NAO V6 - Gesture Lab"
  color 0.08 0.45 0.62
  controller "gesture_player"
  supervisor TRUE
  selfCollision TRUE
  bodySlot [ Speaker { name "speech" } ]
  controllerArgs [ "--trajectory" "examples/edge_pt/trajectory.json" "--audio" "examples/edge_pt/speech.wav" "--out" "webots/results/edge_pt" ]
}
